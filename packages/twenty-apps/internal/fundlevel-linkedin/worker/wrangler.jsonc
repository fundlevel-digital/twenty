{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fundlevel-unipile-archive",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-30",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"vars": {
		// The LinkedIn Sync app's webhook route in Twenty; events are forwarded here after they are stored.
		"TWENTY_WEBHOOK_URL": "https://crm.fundlevel.co/s/linkedin/unipile-webhook"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "unipile-archive",
			"database_id": "d7b830a6-8010-4e9f-9789-1b026ea53861",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// Re-send events Twenty did not accept.
		"crons": ["*/10 * * * *"]
	}
	// Secrets (wrangler secret put): UNIPILE_WEBHOOK_SECRET, INGEST_TOKEN
}
